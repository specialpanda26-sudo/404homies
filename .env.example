# ───────────────────────────────────────────────────────────────
# Copy to .env for local use. On Render, add these under
# Environment → Environment Variables. NEVER commit a real .env.
# ───────────────────────────────────────────────────────────────

# Supabase → Connect → "Session pooler" connection string
DATABASE_URL=postgresql://postgres.xxxx:YOUR_PASSWORD@aws-0-xx.pooler.supabase.com:5432/postgres

# TinyPesa (dashboard → Links → your link)
TINYPESA_API_KEY=your_link_api_key
TINYPESA_USERNAME=your_link_slug

# Secrets: generate each with
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TICKET_SECRET=long_random_string_used_to_sign_ticket_QR_codes
ADMIN_TOKEN=long_random_string_for_admin_login
STAFF_TOKEN=different_random_string_for_door_staff
WEBHOOK_SECRET=another_random_string_put_in_the_webhook_url

# Your public https URL (used for the webhook URL shown in logs)
APP_URL=https://your-app.onrender.com

# ── Optional ────────────────────────────────────────────────────
# WhatsApp group link shown to buyers after payment (leave blank to hide the card)
WHATSAPP_GROUP=
# Shown in the Help drawer. Digits only with country code, e.g. 2547XXXXXXXX
SUPPORT_WHATSAPP=
SUPPORT_PHONE=
# true = test the whole flow with a fake instant payment (refused when NODE_ENV=production)
MOCK_PAYMENTS=false
# Insert the demo "Lakeview House Party" event when the database is empty
SEED_DEMO=true
# Set to false only if legit webhooks get rejected for "TinyPesaID mismatch" (see README)
TINYPESA_STRICT_ID=true
# Local Postgres without SSL: set to false
DATABASE_SSL=true
PORT=3000
